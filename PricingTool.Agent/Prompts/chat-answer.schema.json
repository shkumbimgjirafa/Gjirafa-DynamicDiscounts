{
  "type": "object",
  "additionalProperties": false,
  "required": ["reply", "askAlpha", "briefs", "cancel", "rule", "goal"],
  "properties": {
    "reply": { "type": "string" },
    "askAlpha": { "type": ["string", "null"] },
    "briefs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "layer", "name", "scopeKind", "scopeValue", "startDate", "endDate", "goalType", "goalValue", "minMarginPct", "maxDepthPct", "rationale"],
        "properties": {
          "kind": { "type": "string", "enum": ["mini", "main"] },
          "layer": { "type": "integer", "enum": [1, 4] },
          "name": { "type": "string" },
          "scopeKind": { "type": "string", "enum": ["all", "category", "brand"] },
          "scopeValue": { "type": ["string", "null"] },
          "startDate": { "type": "string" },
          "endDate": { "type": "string" },
          "goalType": { "type": "string", "enum": ["gross-profit", "margin", "units"] },
          "goalValue": { "type": "number" },
          "minMarginPct": { "type": "number" },
          "maxDepthPct": { "type": "number" },
          "rationale": { "type": "string" }
        }
      }
    },
    "cancel": { "type": "array", "maxItems": 10, "items": { "type": "integer" } },
    "goal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["layer", "period", "start", "kind", "value"],
      "properties": {
        "layer": { "type": "integer", "enum": [1, 4] },
        "period": { "type": "string", "enum": ["month", "week"] },
        "start": { "type": "string" },
        "kind": { "type": "string", "enum": ["gross-profit", "margin"] },
        "value": { "type": "number" }
      }
    },
    "rule": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["layer", "kind", "value", "fromDate", "toDate"],
      "properties": {
        "layer": { "type": ["integer", "null"] },
        "kind": { "type": "string", "enum": ["exclude-brand", "exclude-category", "min-campaign-margin", "protect-discount"] },
        "value": { "type": "string" },
        "fromDate": { "type": "string" },
        "toDate": { "type": "string" }
      }
    }
  }
}
