@model IReadOnlyList<PricingTool.Core.Services.ProposalWindowKpi>
@{
    var cur = ViewData.CurrencyCode();
}
@if (Model is not null && Model.Count > 0)
{
    <p class="text-muted small mb-2">
        Projected impact of the proposed prices. The <strong>same-units</strong> line is a conservative
        baseline — it assumes each trailing window sells the same units again at the new price. For
        confidently-elastic SKUs we also show <strong>elastic-predicted</strong>: the volume the fitted
        elasticity expects at the proposed price, and the break-even volume the price move needs. The
        truth sits between the two. Profit &amp; margin are VAT-net; only SKUs with a known cost count.
    </p>
    <div class="row g-3 mb-4">
        @foreach (var k in Model)
        {
            var w = k.Naive;
            var up = w.ProfitDelta >= 0;
            <div class="col-md-4">
                <div class="card h-100 @(up ? "border-success" : "border-warning")">
                    <div class="card-body">
                        <h6 class="text-muted">Profit &amp; margin · @(w.WindowDays)d</h6>

                        @* ---- Naive same-units baseline (conservative) ---- *@
                        <div class="fs-4 @(up ? "text-success" : "text-danger")">
                            @w.ProfitDelta.ToString("+#,##0;-#,##0;0") @cur
                            @if (w.ProfitDeltaPct.HasValue)
                            {
                                <small class="text-muted">(@w.ProfitDeltaPct.Value.ToString("+0.#;-0.#")%)</small>
                            }
                            <span class="badge bg-light text-muted fw-normal ms-1">same units</span>
                        </div>
                        <small class="text-muted d-block">
                            profit @w.ProfitNow.ToString("N0") → @w.ProfitProposed.ToString("N0") @cur
                        </small>
                        <small class="text-muted d-block">
                            margin @(w.MarginNowPct?.ToString("0.#") ?? "–")% → @(w.MarginProposedPct?.ToString("0.#") ?? "–")%
                            @if (w.MarginDeltaPp.HasValue)
                            {
                                <text>(@w.MarginDeltaPp.Value.ToString("+0.#;-0.#")pp)</text>
                            }
                        </small>

                        @* ---- Elasticity-aware projection (model prediction) ---- *@
                        @if (k.Elastic is PricingTool.Core.Services.ElasticProjection e && k.ElasticProfitDelta is decimal ed)
                        {
                            var eup = ed >= 0;
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="text-muted small">Elastic-predicted</span>
                                <span class="text-muted small">@e.SkuCount elastic SKU@(e.SkuCount == 1 ? "" : "s")</span>
                            </div>
                            <div class="fs-5 @(eup ? "text-success" : "text-danger")">
                                @ed.ToString("+#,##0;-#,##0;0") @cur
                                @if (k.ElasticProfitDeltaPct.HasValue)
                                {
                                    <small class="text-muted">(@k.ElasticProfitDeltaPct.Value.ToString("+0.#;-0.#")%)</small>
                                }
                            </div>
                            <small class="text-muted d-block">
                                profit @w.ProfitNow.ToString("N0") → @e.ProfitProposed.ToString("N0") @cur
                            </small>
                            <small class="text-muted d-block">
                                margin @(w.MarginNowPct?.ToString("0.#") ?? "–")% → @(e.MarginProposedPct?.ToString("0.#") ?? "–")%
                                @if (k.ElasticMarginDeltaPp.HasValue)
                                {
                                    <text>(@k.ElasticMarginDeltaPp.Value.ToString("+0.#;-0.#")pp)</text>
                                }
                            </small>
                            <small class="d-block mt-1">
                                @if (e.PredictedLiftPct is decimal pl && e.RequiredLiftPct is decimal rl)
                                {
                                    <span class="text-muted"
                                          title="Margin-weighted volume response vs the uniform lift needed to hold profit flat. Raw units response @e.PredictedUnitsLiftPct.ToString("+0.#;-0.#")% across @e.SkuCount elastic SKU@(e.SkuCount == 1 ? "" : "s").">
                                        fit predicts @pl.ToString("+0.#;-0.#")% · break-even @rl.ToString("+0.#;-0.#")%
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted" title="Proposed price is at/below cost on these SKUs — no volume can break even.">
                                        proposed below cost · no break-even volume
                                    </span>
                                }
                                @if (e.ClearsBreakeven)
                                {
                                    <span class="text-success" title="Predicted volume covers the per-unit margin given up">✓</span>
                                }
                                else
                                {
                                    <span class="text-danger" title="Predicted volume falls short of break-even">✗</span>
                                }
                            </small>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
