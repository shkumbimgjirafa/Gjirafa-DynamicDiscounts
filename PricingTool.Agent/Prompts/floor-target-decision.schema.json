{
  "type": "object",
  "properties": {
    "layer": { "type": "integer", "enum": [1, 4] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bandId": { "type": "integer" },
          "category": { "type": "string" },
          "action": { "enum": ["raise", "lower", "keep"] },
          "newFloorPct": { "type": "number", "minimum": 0, "maximum": 60 },
          "newTargetPct": { "type": "number", "minimum": 0, "maximum": 80 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "maxLength": 800 },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["bandId", "category", "action", "newFloorPct", "newTargetPct", "confidence", "reason", "evidenceRefs"],
        "additionalProperties": false
      }
    },
    "summary": { "type": "string", "maxLength": 1500 }
  },
  "required": ["layer", "decisions", "summary"],
  "additionalProperties": false
}
