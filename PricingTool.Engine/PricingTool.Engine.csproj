<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>gjirafa-hackathon-pricing-agent-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PricingTool.Core\PricingTool.Core.csproj" />
    <ProjectReference Include="..\PricingTool.Data\PricingTool.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PricingTool.Tests" />
  </ItemGroup>

  <!-- Report queries ship next to the dll (read at run time by WeeklyPcsReportWorker). -->
  <ItemGroup>
    <None Update="Reports\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
