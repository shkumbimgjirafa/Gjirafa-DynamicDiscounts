@model AgentStatusViewModel
@using PricingTool.Agent.Alpha
@{
    ViewData["Title"] = "Today";
    var isManager = User.IsInRole(PricingTool.Data.Services.PricingRoles.Manager);
    var ks = Model.KillSwitch;
    var pub = Model.Publisher;
    var inbox = Model.Inbox;
    var today = DateOnly.FromDateTime(DateTime.Now);
    string ModeBadge(AutonomyMode m) => m switch
    {
        AutonomyMode.Autonomous => "bg-success", AutonomyMode.ApproveFirst => "bg-primary", _ => "bg-secondary",
    };
    string PassBadge(string status) => status switch
    {
        "Succeeded" => "bg-success", "Failed" => "bg-danger", "Running" => "bg-primary", _ => "bg-secondary",
    };
    string WhoBadge(string who) => who switch
    {
        "Nova" => "bg-info text-dark", "Alpha" => "bg-primary", "CostWatcher" => "bg-dark", "code" => "bg-secondary", "Publisher" => "bg-success", _ => "bg-warning text-dark",
    };
    string WhoName(string who) => who switch { "CostWatcher" => "Cost watcher", _ => who };
    string LimitWords(string? limit) => limit switch
    {
        "team-discount" => "a cost rise put a team deal under the new floor",
        "cost-above-shelf" => "the new cost is above the shelf price",
        "data-error" => "the cost jump looks like a data error",
        _ => limit ?? "held by the cost watcher",
    };
    // What waits, one line per kind, each linking to its section of the Exceptions tab.
    var waiting = new List<(int Count, string Text, string Anchor)>();
    if (inbox.Decisions.Count > 0) waiting.Add((inbox.Decisions.Count, $"floor or target change{(inbox.Decisions.Count == 1 ? "" : "s")} from Alpha outside the limits", "decisions"));
    foreach (var g in inbox.CostHoldSkus.GroupBy(h => h.Latest.Limit).OrderByDescending(g => g.Count()))
        waiting.Add((g.Count(), $"SKU{(g.Count() == 1 ? "" : "s")}: {LimitWords(g.Key)}", "cost-holds"));
    foreach (var p in inbox.CampaignPlans)
        waiting.Add((1, $"campaign plan: {p.Campaign}, {inbox.LayerName(p.Plan.LayerId)} ({p.Plan.Status}{(string.IsNullOrEmpty(p.Plan.GoalVerdict) ? "" : ", " + p.Plan.GoalVerdict)})", "plans"));
    if (inbox.HeldBriefs.Count > 0) waiting.Add((inbox.HeldBriefs.Count, "campaign brief(s) over a cap", "briefs"));
    if (inbox.BlockedRuns.Count > 0) waiting.Add((inbox.BlockedRuns.Count, "run(s) the checker blocked", "blocked"));
    var publishWaiting = inbox.Publishes.Count(p => p.NeedsAPerson);
    if (publishWaiting > 0) waiting.Add((publishWaiting, "publish(es) stopped, failed or rolled back", "publishing"));
    if (inbox.Pauses.Count > 0) waiting.Add((inbox.Pauses.Count, "band × category paused after a rollback", "pauses"));
    if (inbox.FailedSteps.Count > 0) waiting.Add((inbox.FailedSteps.Count, "daily-cycle step(s) failed", "steps"));
}

<div class="d-flex flex-wrap align-items-baseline gap-3">
    <h1 class="h3 mb-1">Today</h1>
    <span class="text-muted">@DateTime.Now.ToString("dddd d MMMM")</span>
</div>
<p class="page-sub">What Alpha (pricing agent) and Nova (campaign agent) did, what waits for you, and what is coming. Code checks every
    decision against the limits; you hold the switches.</p>

<div class="row g-2 mb-3 small">
    <div class="col-lg-4">
        <div class="tile">
            <div class="text-muted mb-1">Agents' mode per layer</div>
            @foreach (var l in Model.Layers.Where(l => Model.RunWeekLayers.Contains(l.LayerId)))
            {
                <div>@l.Name <span class="badge @ModeBadge(l.Mode)">@l.Mode</span></div>
            }
            @{ var others = Model.Layers.Count(l => !Model.RunWeekLayers.Contains(l.LayerId)); }
            <div class="text-muted">@(others > 0 ? $"{others} more layers without data loaded here · " : "")<a href="#settings">change</a></div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tile">
            <div class="text-muted mb-1">Publishing</div>
            <div>To: <strong>@(pub.IsSandbox ? "sandbox" : "LIVE shop")</strong>@if (pub.IsSandbox) { <span class="text-muted">, the live shop is never touched</span> }</div>
            <div>Layers: @(pub.EnabledLayers.Count > 0 ? string.Join(", ", pub.EnabledLayers.Select(Model.LayerName)) : pub.IsSandbox ? "every layer" : "none")
                · canary @(pub.Canary.Enabled ? $"on ('{pub.Canary.Category}', at most {pub.Canary.MaxSkus} SKUs)" : "off")</div>
            <div class="text-muted">Set in configuration, never in code (GO-LIVE.md).</div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="tile @(ks.Stopped ? "border-danger" : "")">
            <div class="text-muted mb-1">Kill switch</div>
            @if (ks.Stopped)
            {
                <div class="mb-1"><span class="badge bg-danger">Stopped</span> @ks.Reason</div>
            }
            else
            {
                <div class="mb-1"><span class="badge bg-success">Running</span> the agents and the publisher may act</div>
            }
            @if (isManager && !ks.ByConfiguration)
            {
                <form method="post" asp-action="SetKillSwitch" class="d-inline">
                    <input type="hidden" name="stop" value="@(ks.Stopped ? "false" : "true")" />
                    <button type="submit" class="btn btn-sm @(ks.Stopped ? "btn-outline-success" : "btn-outline-danger")">
                        @(ks.Stopped ? "Release the kill switch" : "Pull the kill switch")
                    </button>
                </form>
            }
            <span class="text-muted">Stops every agent call, the run checker and the publisher at once.</span>
        </div>
    </div>
</div>

<h2 class="h5">This week</h2>
<div class="row g-2 mb-4 small">
    @foreach (var (label, value, note) in new[]
    {
        ("Changes applied", Model.Week.DecisionsApplied.ToString("N0"), "Alpha's floors and targets, within the limits"),
        ("Held for a person", (Model.Week.Held + Model.Week.CostWatcherSkusHeld).ToString("N0"),
            $"{Model.Week.Held:N0} from Alpha (outside the limits), {Model.Week.CostWatcherSkusHeld:N0} SKUs from the cost watcher"),
        ("Publishes", $"{Model.Week.Publishes:N0}", $"{Model.Week.DiscountsWritten:N0} discounts written ({(pub.IsSandbox ? "sandbox" : "shop")})"),
        ("AI cost", $"${Model.Week.AiCostUsd:0.00}", $"{Model.Week.AiCalls:N0} calls, measured"),
        ("Extra GP vs the holdout", Model.Week.MeasuredGp30 is { } g ? $"€{g:N0}" : "not measured yet", Model.Week.MeasuredGp30 is null ? $"{Model.Week.LedgerEntries} ledger entries wait for their 30 days" : "measured, 30 days"),
    })
    {
        <div class="col-6 col-lg"><div class="tile"><div class="text-muted">@label</div><div class="tile-value">@value</div><div class="text-muted">@note</div></div></div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100 @(Model.Waiting > 0 ? "border-warning" : "border-success")">
            <div class="card-body">
                <h2 class="h5 d-flex justify-content-between">Waiting for you
                    <span class="badge @(Model.Waiting > 0 ? "bg-warning text-dark" : "bg-success")">@Model.Waiting</span></h2>
                @if (waiting.Count == 0)
                {
                    <p class="text-muted mb-0">Nothing. On a normal day this stays empty.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-2">
                        @foreach (var (count, text, anchor) in waiting)
                        {
                            <li class="mb-1"><span class="badge bg-light text-dark border me-1">@count</span>
                                <a asp-action="Exceptions" asp-fragment="@anchor">@text</a></li>
                        }
                    </ul>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Exceptions">Open the Exceptions tab</a>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5">Coming up <span class="small text-muted">next 3 weeks</span></h2>
                <table class="table table-sm align-middle small mb-2">
                    <tbody>
                    @foreach (var r in Model.ComingUp)
                    {
                        <tr>
                            <td class="text-nowrap">@r.Entry.StartDate.ToString("ddd dd MMM")</td>
                            <td><a asp-controller="Campaigns" asp-action="Detail" asp-route-id="@r.Entry.Id">@r.Entry.Name</a>
                                <div class="text-muted">@Model.LayerName(r.Entry.LayerId)</div></td>
                            <td>@(r.Plan is { } p ? $"{p.Status}{(string.IsNullOrEmpty(p.GoalVerdict) ? "" : ", " + p.GoalVerdict)}" : r.Brief is { } b ? $"brief {b.Status}" : "no brief yet")
                                @if (r.CanStop(today)) { <div class="text-warning-emphasis">goes live unless you stop it</div> }</td>
                        </tr>
                    }
                    @if (Model.ComingUp.Count == 0) { <tr><td class="text-muted">Nothing in the next three weeks.</td></tr> }
                    </tbody>
                </table>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Campaigns" asp-action="Index">Campaigns</a>
            </div>
        </div>
    </div>
</div>

<h2 class="h5" id="run-week">Run week</h2>
<details class="how"><summary>How it works</summary>
    The whole loop for one layer with no clicks in between: Alpha's pass in the layer's mode → an engine run with the per-category
    rules → the run checker → the checked prices published to the shop @(pub.IsSandbox ? "sandbox" : "") → the round-trip read-back.
    A block at any step stops what comes after it; the kill switch stops it before Alpha. No export file is written: the daily
    cycle's push file stays separate.
</details>
@if (isManager)
{
    <div class="mb-2">
        @foreach (var l in Model.Layers.Where(l => Model.RunWeekLayers.Contains(l.LayerId)))
        {
            <form method="post" asp-action="RunWeek" class="d-inline">
                <input type="hidden" name="layerId" value="@l.LayerId" />
                <button class="btn btn-sm btn-outline-primary me-1" disabled="@(Model.RunWeekRunning || ks.Stopped)">Run week: @l.Name</button>
            </form>
        }
        @if (ks.Stopped) { <span class="small text-danger">The kill switch is pulled.</span> }
    </div>
}
@foreach (var (week, steps) in Model.RunWeeks)
{
    <div class="card mb-3 small">
        <div class="card-body py-2">
            <div class="mb-1"><strong>Run week #@week.Id</strong>, @Model.LayerName(week.LayerId), by @week.StartedBy, @week.StartedUtc.ToLocalTime().ToString("ddd dd MMM HH:mm")
                <span class="badge @PassBadge(week.Status == "Stopped" ? "Skipped" : week.Status)">@week.Status</span>
                @if (week.FinishedUtc is { } done) { <span>in @((done - week.StartedUtc).TotalSeconds.ToString("N0")) s;</span> }
                <span class="text-muted">AI: @week.AiCalls calls, $@week.AiCostUsd.ToString("0.00") (measured, API-equivalent)</span></div>
            @if (week.Outcome is { } outcome) { <div class="mb-1">@outcome</div> }
            <table class="table table-sm mb-0 align-middle">
                <thead><tr><th>Step</th><th>Status</th><th class="text-end">Seconds</th><th>Result</th><th>Why</th></tr></thead>
                <tbody>
                @foreach (var s in steps)
                {
                    <tr>
                        <td><code>@s.Step</code></td>
                        <td><span class="badge @(s.Status switch { "Succeeded" => "bg-success", "Failed" => "bg-danger", "Running" => "bg-primary", "Warning" => "bg-warning text-dark", _ => "bg-secondary" })">@s.Status</span></td>
                        <td class="text-end">@(s.FinishedUtc is { } f ? (f - s.StartedUtc).TotalSeconds.ToString("N0") : "…")</td>
                        <td>@s.Detail</td>
                        <td>@if (!string.IsNullOrEmpty(s.Why)) { <details><summary>why?</summary>@s.Why</details> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
@if (Model.RunWeekRunning)
{
    <script>setTimeout(function () { location.reload(); }, 5000);</script>
}

<h2 class="h5">What they did <span class="small text-muted">last 7 days, newest first</span></h2>
<div class="mb-4 border rounded" style="max-height: 28rem; overflow-y: auto">
<table class="table table-sm align-middle small mb-0">
    <tbody>
    @foreach (var f in Model.Feed)
    {
        <tr>
            <td class="text-nowrap text-muted">@f.Utc.ToLocalTime().ToString("ddd HH:mm")</td>
            <td><span class="badge @WhoBadge(f.Who)">@WhoName(f.Who)</span></td>
            <td class="text-nowrap">@(f.LayerId is { } lid ? Model.LayerName(lid) : "")</td>
            <td>
                @if (f.Link is not null) { <a href="@f.Link">@f.What</a> } else { @f.What }
                @if (!string.IsNullOrWhiteSpace(f.Why))
                {
                    <details><summary class="text-muted">@(f.Count > 1 ? $"why? ({f.Count:N0})" : "why?")</summary><div style="white-space: pre-wrap">@f.Why</div></details>
                }
            </td>
        </tr>
    }
    @if (Model.Feed.Count == 0) { <tr><td class="text-muted">Nothing in the last 7 days.</td></tr> }
    </tbody>
</table>
</div>

<h2 class="h5" id="chat">Talk to the agents</h2>
<details class="how"><summary>What you can ask</summary>
    Nova (campaigns) answers; write <code>@@alpha</code> to ask Alpha (pricing). Ask why they did something, what a change would do, or ask
    for a campaign ("Plan a 3-day laptops campaign next week, €4k profit"): code checks the brief against the limits, Alpha plans it and it
    publishes to the sandbox, where you can stop it until it starts. Instructions ("keep Samsung out this week") become rules code enforces.
    They read the data first: an answer takes up to a minute or two.
</details>
<div class="row g-3 mb-4">
    <div class="col-lg-9">
        <div class="border rounded p-2 mb-2" style="max-height: 30rem; overflow-y: auto">
            @foreach (var m in Model.Chat)
            {
                <div class="mb-2 @(m.From == "user" ? "text-end" : "")">
                    <span class="badge @(m.From switch { "Nova" => "bg-info text-dark", "Alpha" => "bg-primary", "code" => "bg-secondary", _ => "bg-light text-dark" })">@(m.From == "user" ? m.Author ?? "you" : m.From)</span>
                    <span class="small text-muted">@m.CreatedUtc.ToLocalTime().ToString("ddd HH:mm")</span>
                    <div class="small" style="white-space: pre-wrap">@m.Text</div>
                </div>
            }
            @if (Model.Chat.Count == 0) { <p class="text-muted small mb-0">No conversation yet.</p> }
        </div>
        @if (isManager)
        {
            <form method="post" asp-action="Chat" onsubmit="this.querySelector('button').disabled = true; this.querySelector('button').innerText = 'The agents are reading the data…';">
                <input type="hidden" name="conversationId" value="@Model.ConversationId" />
                <div class="input-group">
                    <textarea name="text" class="form-control" rows="2" maxlength="2000" placeholder="Ask Nova, or @@alpha …" required></textarea>
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
            </form>
        }
    </div>
    <div class="col-lg-3 small">
        <a asp-action="Index" asp-route-conversation="0" asp-fragment="chat">New conversation</a>
        <ul class="list-unstyled mt-2">
            @foreach (var c in Model.Conversations)
            {
                <li class="mb-1"><a asp-action="Index" asp-route-conversation="@c.Id" asp-fragment="chat" class="@(c.Id == Model.ConversationId ? "fw-bold" : "")">
                    @c.StartedUtc.ToLocalTime().ToString("dd MMM HH:mm")</a>: @(c.First.Length > 60 ? c.First[..60] + "…" : c.First)</li>
            }
        </ul>
    </div>
</div>

<h2 class="h5">What they looked at <span class="small text-muted">the agents' data queries, newest first</span></h2>
<div class="mb-4 border rounded" style="max-height: 20rem; overflow-y: auto">
<table class="table table-sm align-middle small mb-0">
    <thead><tr><th>When</th><th>Agent</th><th>Tool</th><th>Request</th><th class="text-end">Rows</th><th class="text-end">ms</th><th></th></tr></thead>
    <tbody>
    @foreach (var q in Model.Queries)
    {
        <tr class="@(q.Accepted ? "" : "table-warning")">
            <td class="text-nowrap">@q.CalledAtUtc.ToLocalTime().ToString("ddd HH:mm")</td><td>@q.Agent</td><td>@q.Tool</td>
            <td class="text-break"><code>@(q.Request.Length > 220 ? q.Request[..220] + "…" : q.Request)</code></td>
            <td class="text-end">@q.RowCount</td><td class="text-end">@q.DurationMs</td>
            <td>@(q.Accepted ? (q.Truncated ? "truncated" : "") : $"refused: {q.Error}")</td>
        </tr>
    }
    @if (Model.Queries.Count == 0) { <tr><td colspan="7" class="text-muted">No calls yet.</td></tr> }
    </tbody>
</table>
</div>

<h2 class="h5" id="rules">Rules from people <span class="small text-muted">instructions given in the chat; they only tighten the limits</span></h2>
<table class="table table-sm align-middle small mb-4">
    <thead><tr><th>#</th><th>Rule</th><th>Layer</th><th>Days</th><th>From</th>@if (isManager) { <th></th> }</tr></thead>
    <tbody>
    @foreach (var r in Model.Rules)
    {
        <tr>
            <td>@r.Id</td><td>@r.Kind <strong>@r.Value@(r.Kind == "min-campaign-margin" ? "%" : "")</strong></td>
            <td>@(r.LayerId is { } lid ? Model.LayerName(lid) : "both")</td><td class="text-nowrap">@r.FromDate.ToString("dd MMM")–@r.ToDate.ToString("dd MMM yyyy")</td>
            <td>@r.CreatedBy: "@r.Instruction"</td>
            @if (isManager)
            {
                <td><form method="post" asp-action="RemoveRule"><input type="hidden" name="ruleId" value="@r.Id" /><button class="btn btn-sm btn-outline-secondary">Remove</button></form></td>
            }
        </tr>
    }
    @if (Model.Rules.Count == 0) { <tr><td colspan="6" class="text-muted">None.</td></tr> }
    </tbody>
</table>

<h2 class="h5" id="settings">Settings and history</h2>

<details class="mb-3">
    <summary class="h6">Autonomy per layer</summary>
    <p class="small text-muted">Off: no pass. Approve-first: every change waits for one click. Autonomous: changes within the limits apply
        by themselves and only what is outside them waits. A layer without a setting is approve-first.</p>
    <table class="table table-sm align-middle">
        <thead><tr><th>Layer</th><th>Mode</th>@if (isManager) { <th>Change</th> }</tr></thead>
        <tbody>
        @foreach (var l in Model.Layers)
        {
            <tr>
                <td>@l.Name</td>
                <td><span class="badge @ModeBadge(l.Mode)">@l.Mode</span></td>
                @if (isManager)
                {
                    <td>
                        <form method="post" asp-action="SetMode" class="d-flex gap-2">
                            <input type="hidden" name="layerId" value="@l.LayerId" />
                            <select name="mode" class="form-select form-select-sm w-auto">
                                @foreach (var m in Enum.GetValues<AutonomyMode>())
                                {
                                    <option value="@m" selected="@(m == l.Mode)">@m</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</details>

<details class="mb-3">
    <summary class="h6">Recent passes (@Model.RecentPasses.Count)</summary>
    <table class="table table-sm align-middle small">
        <thead><tr><th>#</th><th>Agent</th><th>Layer</th><th>Mode</th><th>Status</th><th>Started</th>
            <th class="text-end" title="Applied decisions that changed a floor or target; keeps are applied too but change nothing">Changed</th>
            <th class="text-end">Kept</th><th class="text-end">Held</th><th class="text-end">Rejected</th><th class="text-end">Pending</th><th>Summary</th></tr></thead>
        <tbody>
        @foreach (var p in Model.RecentPasses)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Source</td>
                <td>@Model.LayerName(p.LayerId)</td>
                <td>@p.Mode</td>
                <td><span class="badge @PassBadge(p.Status)">@p.Status</span></td>
                <td>@p.StartedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                <td class="text-end">@Model.Changed.GetValueOrDefault(p.Id)</td>
                <td class="text-end">@(p.Applied - Model.Changed.GetValueOrDefault(p.Id))</td>
                <td class="text-end">@p.Held</td>
                <td class="text-end">@p.Rejected</td>
                <td class="text-end">@p.Pending</td>
                <td class="small text-break">@(p.Summary ?? p.Error)</td>
            </tr>
        }
        @if (Model.RecentPasses.Count == 0)
        {
            <tr><td colspan="12" class="text-muted">No real passes yet.</td></tr>
        }
        </tbody>
    </table>
</details>

<details class="mb-4">
    <summary class="h6">What the agents keep in mind (@Model.Lessons.Count)</summary>
    <p class="small text-muted">Lessons from people and corrections code recorded when a person overrode an agent; every pass reads them until a person retires one.</p>
    <table class="table table-sm align-middle small">
        <thead><tr><th>#</th><th>Agent</th><th>Layer</th><th>From</th><th>Lesson</th>@if (isManager) { <th></th> }</tr></thead>
        <tbody>
        @foreach (var l in Model.Lessons)
        {
            <tr>
                <td>@l.Id</td><td>@l.Agent</td><td>@(l.LayerId is { } lid ? Model.LayerName(lid) : "all")</td>
                <td class="text-nowrap">@l.CreatedBy, @l.CreatedUtc.ToLocalTime().ToString("dd MMM") @(l.Source == "correction" ? "(a correction)" : "")</td>
                <td class="text-break">@l.Text</td>
                @if (isManager)
                {
                    <td><form method="post" asp-action="RetireLesson"><input type="hidden" name="lessonId" value="@l.Id" /><button class="btn btn-sm btn-outline-secondary">Retire</button></form></td>
                }
            </tr>
        }
        @if (Model.Lessons.Count == 0) { <tr><td colspan="6" class="text-muted">None yet.</td></tr> }
        </tbody>
    </table>
    @if (isManager)
    {
        <form method="post" asp-action="AddLesson" class="row g-2 align-items-end">
            <div class="col-auto"><label class="form-label small">Agent</label><select name="agent" class="form-select form-select-sm"><option>Nova</option><option>Alpha</option></select></div>
            <div class="col-auto"><label class="form-label small">Layer</label>
                <select name="layerId" class="form-select form-select-sm"><option value="">all</option>
                    @foreach (var l in Model.Layers) { <option value="@l.LayerId">@l.Name</option> }
                </select></div>
            <div class="col"><label class="form-label small">Lesson</label><input name="text" class="form-control form-control-sm" maxlength="2000" required /></div>
            <div class="col-auto"><button class="btn btn-sm btn-outline-primary">Teach</button></div>
        </form>
    }
</details>
