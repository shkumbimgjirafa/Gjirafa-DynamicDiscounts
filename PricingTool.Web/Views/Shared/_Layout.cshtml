@using Microsoft.Extensions.Options
@using PricingTool.Web.Options
@inject IOptions<PortaOptions> PortaOpts
@inject IOptions<PricingTool.NopIntegration.PublisherOptions> PublisherOpts
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Pricing Tool v2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var activeLayers = ViewData["ActiveLayers"] as IReadOnlyList<PricingTool.Data.Entities.Layer>
        ?? new List<PricingTool.Data.Entities.Layer>();
    var currentLayer = ViewData["CurrentLayer"] as PricingTool.Data.Entities.Layer;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var isSandbox = PublisherOpts.Value.IsSandbox;
    var controller = ViewContext.RouteData.Values["controller"] as string ?? "";
    var action = ViewContext.RouteData.Values["action"] as string ?? "";
    bool At(string c, string? a = null) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
                                          && (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase));
    string On(bool active) => active ? " active" : "";
    var inAdmin = At("Operations") || At("Audit") || At("Users") || At("Schedule") || At("Bands") || At("Movers");
}
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Run" asp-action="Index">⚡ Pricing Tool v2</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link@(On(At("Run")))" asp-controller="Run" asp-action="Index">Run</a></li>
                        <li class="nav-item"><a class="nav-link@(On(At("Chat") || At("Agent")))" asp-controller="Chat" asp-action="Index">Chat
                            @if (User.Identity?.IsAuthenticated == true) { @await Component.InvokeAsync("WaitingBadge") }</a></li>
                        <li class="nav-item"><a class="nav-link@(On(At("Campaigns")))" asp-controller="Campaigns" asp-action="Index">Campaigns</a></li>
                        <li class="nav-item"><a class="nav-link@(On(At("Proposals") || At("Sku")))" asp-controller="Proposals" asp-action="Index">Proposals</a></li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle@(On(inAdmin))" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Operations" asp-action="Cycle">Daily cycle</a></li>
                                <li><a class="dropdown-item" asp-controller="Audit" asp-action="Index">Audit log</a></li>
                                <li><a class="dropdown-item" asp-controller="Operations" asp-action="TimeSheet">Time sheet</a></li>
                                @if (User.IsInRole(PricingTool.Data.Services.PricingRoles.Manager))
                                {
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Users</a></li>
                                }
                            </ul>
                        </li>
                        @if (currentLayer is not null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false"
                                   title="Switch layer (brand / country)">
                                    🗂 @currentLayer.DisplayName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @foreach (var brandGroup in activeLayers.GroupBy(l => l.Brand))
                                    {
                                        <li><h6 class="dropdown-header">@brandGroup.Key</h6></li>
                                        @foreach (var layer in brandGroup)
                                        {
                                            <li>
                                                <a class="dropdown-item @(layer.Id == currentLayer.Id ? "active" : "")"
                                                   asp-controller="Layer" asp-action="Select"
                                                   asp-route-layerId="@layer.Id" asp-route-returnUrl="@returnUrl">
                                                    @layer.CountryCode — @layer.Currency
                                                </a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-light" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                👤 @(User.Identity?.Name ?? "guest")
                                @if (!PortaOpts.Value.IsConfigured)
                                {
                                    <span class="badge bg-secondary" title="Porta SSO not configured — running with the dev no-auth shim">no-auth</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (PortaOpts.Value.IsConfigured)
                                {
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Sign out</button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li><span class="dropdown-item-text small text-muted">Porta SSO disabled (dev mode)</span></li>
                                }
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="status-strip small px-4 py-1 mb-3 d-flex flex-wrap gap-3">
            @if (isSandbox)
            {
                <span><span class="badge bg-success">Publishing to: sandbox</span> the live shop is never touched</span>
            }
            else
            {
                <span><span class="badge bg-danger">Publishing to: LIVE shop</span> @string.Join(", ", PublisherOpts.Value.EnabledLayers.Select(l => $"layer {l}"))</span>
            }
            <span class="text-muted">@await Component.InvokeAsync("DataStatus", new { view = "Strip" })</span>
        </div>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success alert-dismissible fade show">@message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show">@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (ViewData["RunNote"] is string runNote)
            {
                <div class="alert alert-info py-2 small">@runNote</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid px-4">
            <div>Pricing Tool v2: Alpha (pricing agent) and Nova (campaign agent) set floors, targets and campaigns; code enforces
                every limit; the publisher writes the shop's discounts@(isSandbox ? " to the sandbox copy during the hackathon" : "").</div>
            @await Component.InvokeAsync("DataStatus", new { view = "Footer" })
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // The agents write a little Markdown. In elements marked .md-lite, show **text** as bold, a line's leading "- " as a
        // bullet, and a Run week price list's path (/Run/PriceList/<id>) as its download link. Works on text nodes only (no HTML
        // is parsed), so nothing else changes.
        (function () {
            var link = /(\/Run\/PriceList\/\d+)/;
            function appendText(frag, text) {
                text.split(link).forEach(function (p, i) {
                    if (i % 2) { var a = document.createElement('a'); a.href = p; a.textContent = p; frag.appendChild(a); }
                    else if (p) { frag.appendChild(document.createTextNode(p)); }
                });
            }
            document.querySelectorAll('.md-lite').forEach(function (el) {
                var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), nodes = [];
                while (walker.nextNode()) nodes.push(walker.currentNode);
                nodes.forEach(function (n) {
                    var text = n.nodeValue.replace(/(^|\n)(\s*)- /g, '$1$2• ');
                    var parts = text.split(/\*\*([^*\n]+?)\*\*/);
                    if (parts.length < 2 && !link.test(text)) { if (text !== n.nodeValue) n.nodeValue = text; return; }
                    var frag = document.createDocumentFragment();
                    parts.forEach(function (p, i) {
                        if (i % 2) { var b = document.createElement('strong'); b.textContent = p; frag.appendChild(b); }
                        else if (p) { appendText(frag, p); }
                    });
                    n.parentNode.replaceChild(frag, n);
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
