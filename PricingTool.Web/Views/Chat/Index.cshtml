@model ChatPageModel
@{
    ViewData["Title"] = "Chat";
    var isManager = User.IsInRole(PricingTool.Data.Services.PricingRoles.Manager);
    var inbox = Model.Inbox;
    var today = DateOnly.FromDateTime(DateTime.Now);
    string WhoBadge(string who) => who switch
    {
        "Nova" => "bg-info text-dark", "Alpha" => "bg-primary", "CostWatcher" => "bg-dark", "code" => "bg-secondary", "Publisher" => "bg-success", _ => "bg-warning text-dark",
    };
    string WhoName(string who) => who switch { "CostWatcher" => "Cost watcher", "code" => "Code", _ => who };
    DateTime Local(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();
    var publishWaiting = inbox.Publishes.Count(p => p.NeedsAPerson);
    string RuleWords(string kind) => kind switch
    {
        "exclude-brand" => "Keep brand out",
        "exclude-category" => "Keep category out",
        "min-campaign-margin" => "Campaign margin at least",
        "protect-discount" => "Never end team discount",
        "margin-target" => "Shop margin target",
        _ => kind,
    };
}

<div class="page-head">
    <div class="d-flex flex-wrap align-items-baseline gap-3">
        <h1 class="h3">Chat</h1>
        <div class="form-check form-switch small">
            <input class="form-check-input" type="checkbox" id="show-activity" checked />
            <label class="form-check-label" for="show-activity">show what the agents did</label>
        </div>
    </div>
    <p class="page-intro mb-0">Talk to Nova (campaign agent) and Alpha (pricing agent): their reasoning, what they did, and the chat with them.
        "Waiting for you" lists only what they couldn't settle themselves.</p>
</div>

<div class="chat-layout">
    <section class="chat-main" aria-label="Chat with the agents">
        <div id="thread" class="border rounded p-2 mb-2" style="height: 68vh; overflow-y: auto">
            @{ DateOnly? day = null; }
            @foreach (var t in Model.Thread)
            {
                var d = DateOnly.FromDateTime(Local(t.Utc));
                if (day != d)
                {
                    day = d;
                    <div class="day-divider">@Local(t.Utc).ToString("dddd d MMMM")</div>
                }
                if (t.Message is { } m)
                {
                    var mine = m.From == "user";
                    <div class="d-flex @(mine ? "justify-content-end" : "") mb-2">
                        <div class="msg @(mine ? "msg-mine" : m.From == "code" ? "msg-code" : "msg-agent")">
                            <div class="msg-head">
                                <span class="badge @(mine ? "bg-light text-dark border" : WhoBadge(m.From))">@(mine ? m.Author ?? "you" : WhoName(m.From))</span>
                                <span class="text-muted">@Local(m.CreatedUtc).ToString("HH:mm")</span>
                            </div>
                            <div class="pre-wrap md-lite">@m.Text</div>
                        </div>
                    </div>
                }
                else if (t.Activity is { } f)
                {
                    <div class="activity text-muted">
                        <span>@Local(f.Utc).ToString("HH:mm")</span>
                        <span class="badge @WhoBadge(f.Who)">@WhoName(f.Who)</span>
                        @if (f.LayerId is { } lid) { <span>@Model.LayerName(lid):</span> }
                        @if (f.Link is not null) { <a href="@f.Link">@f.What</a> } else { <span class="text-body">@f.What</span> }
                        @if (!string.IsNullOrWhiteSpace(f.Why))
                        {
                            <details class="d-inline"><summary class="d-inline">@(f.Count > 1 ? $"why? ({f.Count:N0})" : "why?")</summary>
                                <div class="text-body pre-wrap md-lite">@f.Why</div></details>
                        }
                    </div>
                }
            }
            @if (Model.Thread.Count == 0) { <p class="text-muted small">Nothing yet.</p> }
            @if (Model.TurnRunning)
            {
                <div class="small text-muted mb-1"><span class="spinner-border spinner-border-sm"></span> @(Model.Answering ?? "Nova") is reading the data…</div>
            }
            @if (Model.ProblemsRunning)
            {
                <div class="small text-muted mb-1"><span class="spinner-border spinner-border-sm"></span> Alpha is looking at what's waiting…</div>
            }
            <div id="bottom"></div>
        </div>
        @if (isManager)
        {
            <form method="post" asp-controller="Agent" asp-action="Chat">
                <input type="hidden" name="conversationId" value="@Model.ConversationId" />
                <div class="input-group">
                    <textarea name="text" class="form-control" rows="2" maxlength="2000" required
                              placeholder="Ask Nova, or start with @@alpha to ask Alpha…"></textarea>
                    <button type="submit" class="btn btn-primary" disabled="@Model.TurnRunning">Send</button>
                </div>
            </form>
            <details class="how mt-1"><summary>What you can say</summary>
                Ask why they did something, or what a change would do. Ask Nova for a campaign ("Plan a 3-day laptops campaign next week, €4k
                profit"): code checks the brief against the limits, Alpha plans it, and it publishes to the sandbox, where you can stop it until
                it starts. Give instructions ("keep Samsung out this week"): they become rules code enforces, listed under "Rules you gave". The agents
                read the data first, so an answer takes up to a minute or two; the page refreshes when it lands.
            </details>
        }
    </section>

    <aside class="chat-waiting small" aria-label="Waiting for you">
        <div class="card @(inbox.WaitingCount > 0 ? "border-warning border-2" : "border-success")">
            <div class="card-body">
                <h2 class="h6 d-flex justify-content-between align-items-center">Waiting for you
                    <span class="badge rounded-pill @(inbox.WaitingCount > 0 ? "bg-warning text-dark" : "bg-success")">@inbox.WaitingCount</span></h2>
                @if (inbox.WaitingCount == 0) { <p class="text-muted mb-0">Nothing: the agents settled everything themselves.</p> }
                @foreach (var g in inbox.CostHoldSkus.GroupBy(h => h.Latest.Limit).OrderByDescending(g => g.Count()))
                {
                    var owners = g.Where(h => h.Latest.ReportedTo is not null).GroupBy(h => h.Latest.ReportedTo!).OrderByDescending(o => o.Count()).ToList();
                    <div class="mb-2">
                        <span class="badge bg-light text-dark border">@g.Count()</span>
                        SKU@(g.Count() == 1 ? "" : "s"): @PricingTool.Web.Services.AgentActivity.LimitWords(g.Key)
                        <div class="text-muted">@string.Join(", ", g.GroupBy(h => h.LayerId).Select(x => $"{x.Count()} on {Model.LayerName(x.Key)}")).
                            <a asp-controller="Agent" asp-action="Exceptions" asp-fragment="cost-holds">the SKUs</a></div>
                        @foreach (var o in owners)
                        {
                            <div><span class="text-muted">Alpha: for</span> <strong>@o.Key</strong> (@o.Count())</div>
                            <details><summary class="text-muted">Alpha's notes</summary>
                                @foreach (var h in o.Take(10)) { <div><code>@h.Sku</code>: @h.Latest.ReportNote</div> }</details>
                        }
                        @if (owners.Count == 0) { <div class="text-muted">Alpha hasn't looked at these yet.</div> }
                    </div>
                }
                @foreach (var p in inbox.CampaignPlans)
                {
                    <div class="mb-2">
                        <span class="badge bg-light text-dark border">1</span>
                        Campaign plan for <strong>@p.Campaign</strong> (@Model.LayerName(p.Plan.LayerId)): @p.Plan.Status@(string.IsNullOrEmpty(p.Plan.GoalVerdict) ? "" : ", " + p.Plan.GoalVerdict),
                        goal @p.GoalType @p.GoalValue.ToString("N0").
                        <details><summary class="text-muted">the numbers</summary>@p.Plan.Feasibility</details>
                        @if (isManager)
                        {
                            <form asp-controller="Agent" asp-action="ApprovePlan" method="post" class="d-inline">
                                <input type="hidden" name="planId" value="@p.Plan.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary py-0">@(p.Plan.Status == "held" ? "Approve as it is" : "Approve as a stretch")</button>
                            </form>
                        }
                    </div>
                }
                @foreach (var (count, text) in new[]
                {
                    (inbox.Decisions.Count, "floor or target change(s) from Alpha outside the limits"),
                    (inbox.HeldBriefs.Count, "campaign brief(s) over a cap"),
                    (inbox.BlockedRuns.Count, "run(s) the checker blocked"),
                    (publishWaiting, "publish(es) stopped, failed or rolled back"),
                    (inbox.Pauses.Count, "band × category paused after a rollback"),
                    (inbox.FailedSteps.Count, "daily-cycle step(s) failed"),
                }.Where(x => x.Item1 > 0))
                {
                    <div class="mb-2"><span class="badge bg-light text-dark border">@count</span>
                        <a asp-controller="Agent" asp-action="Exceptions">@text</a></div>
                }
                @if (inbox.WaitingCount > 0)
                {
                    <a class="small" asp-controller="Agent" asp-action="Exceptions">All the details</a>
                }
                @if (isManager)
                {
                    <form method="post" asp-controller="Agent" asp-action="Problems" class="mt-2">
                        <button class="btn btn-sm btn-outline-primary" disabled="@Model.ProblemsRunning">Ask Alpha to look now</button>
                        <div class="text-muted mt-1">Code settles what it can (closes what resolved itself, ends a team discount under the floor), then
                            Alpha looks at the rest and posts who can fix it. It also runs once a day.</div>
                    </form>
                }
            </div>
        </div>
    </aside>

    <aside class="chat-side small" aria-label="Goals, campaigns and rules">
        <div class="card mb-3" id="goals">
            <div class="card-body">
                <h2 class="h6">Goals</h2>
                @foreach (var g in Model.Goals)
                {
                    <div class="mb-2 d-flex justify-content-between gap-2">
                        <div>
                            <strong>@Model.LayerName(g.Goal.LayerId)</strong>, @(g.Goal.Period == "month" ? g.Goal.Start.ToString("MMMM") : $"week of {g.Goal.Start:d MMM}"):
                            @(g.Goal.Kind == "gross-profit" ? $"€{g.Goal.Value:N0} gross profit" : $"{g.Goal.Value:0.#}% margin")
                            <div class="@(g.OnTrack == false ? "text-danger" : g.OnTrack == true ? "text-success" : "text-muted")">
                                @if (g.Goal.Kind == "gross-profit")
                                {
                                    <span>€@g.GrossProfit.ToString("N0") so far (@(((g.ShareOfGoal ?? 0m) * 100m).ToString("0"))%), @((g.ElapsedShare * 100m).ToString("0"))% of the @g.Goal.Period gone@(g.Projected is { } pj ? $"; at this pace €{pj:N0}" : "")</span>
                                }
                                else
                                {
                                    <span>@(g.MarginPct?.ToString("0.0") ?? "–")% so far</span>
                                }
                            </div>
                            <div class="text-muted">@g.Goal.SetBy: "@g.Goal.Instruction"</div>
                        </div>
                        @if (isManager)
                        {
                            <form method="post" asp-controller="Agent" asp-action="RetireGoal"><input type="hidden" name="goalId" value="@g.Goal.Id" />
                                <button class="btn btn-sm btn-outline-secondary py-0">Remove</button></form>
                        }
                    </div>
                }
                @if (Model.Goals.Count == 0)
                {
                    <p class="text-muted mb-0">None yet. Tell Nova the month's or week's goal per layer, e.g. "GjirafaMall: €180k gross profit this month" or
                        "Gjirafa50 at 12% margin this week". Measured on the booked sales lines (VAT excluded).</p>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6">Coming up <span class="text-muted fw-normal">next 3 weeks</span></h2>
                @foreach (var c in Model.ComingUp)
                {
                    <div class="mb-1">
                        <span class="text-muted">@c.Entry.StartDate.ToString("ddd d MMM")</span>
                        <a asp-controller="Campaigns" asp-action="Index" asp-route-id="@c.Entry.Id">@c.Entry.Name</a>
                        <span class="text-muted">@Model.LayerName(c.Entry.LayerId)</span>:
                        @(c.Plan is { } pl ? $"{pl.Status}{(string.IsNullOrEmpty(pl.GoalVerdict) ? "" : ", " + pl.GoalVerdict)}" : c.Brief is { } b ? $"brief {b.Status}" : "no brief yet")
                        @if (c.CanStop(today)) { <span class="text-warning-emphasis">(goes live unless you stop it)</span> }
                    </div>
                }
                @if (Model.ComingUp.Count == 0) { <p class="text-muted mb-0">No campaign in the next three weeks.</p> }
                <a asp-controller="Campaigns" asp-action="Index">All campaigns</a>
            </div>
        </div>

        <div class="card mb-3" id="rules">
            <div class="card-body">
                <h2 class="h6">Rules you gave</h2>
                @foreach (var r in Model.Rules)
                {
                    <div class="mb-2 d-flex justify-content-between gap-2">
                        <div><span title="@r.Kind">@RuleWords(r.Kind)</span> <strong>@r.Value@(r.Kind is "min-campaign-margin" or "margin-target" && !r.Value.TrimEnd().EndsWith("%") ? "%" : "")</strong>,
                            @(r.LayerId is { } lid ? Model.LayerName(lid) : "both layers"), @r.FromDate.ToString("d MMM")–@r.ToDate.ToString("d MMM")
                            <div class="text-muted">@r.CreatedBy: "@r.Instruction"</div></div>
                        @if (isManager)
                        {
                            <form method="post" asp-controller="Agent" asp-action="RemoveRule"><input type="hidden" name="ruleId" value="@r.Id" />
                                <button class="btn btn-sm btn-outline-secondary py-0">Remove</button></form>
                        }
                    </div>
                }
                @if (Model.Rules.Count == 0) { <p class="text-muted mb-0">None. Instructions you give in the chat appear here.</p> }
            </div>
        </div>

        <details class="mb-3" id="lessons">
            <summary class="h6">What the agents keep in mind (@Model.Lessons.Count)</summary>
            @foreach (var l in Model.Lessons)
            {
                <div class="mb-1 d-flex justify-content-between gap-2">
                    <div><strong>@l.Agent</strong>, @(l.LayerId is { } lid ? Model.LayerName(lid) : "all layers"): @l.Text
                        <div class="text-muted">@l.CreatedBy, @l.CreatedUtc.ToLocalTime().ToString("d MMM") @(l.Source == "correction" ? "(a correction)" : "")</div></div>
                    @if (isManager)
                    {
                        <form method="post" asp-controller="Agent" asp-action="RetireLesson"><input type="hidden" name="lessonId" value="@l.Id" />
                            <button class="btn btn-sm btn-outline-secondary py-0">Retire</button></form>
                    }
                </div>
            }
            @if (isManager)
            {
                <form method="post" asp-controller="Agent" asp-action="AddLesson" class="mt-2">
                    <div class="d-flex gap-1 mb-1">
                        <select name="agent" class="form-select form-select-sm"><option>Nova</option><option>Alpha</option></select>
                        <select name="layerId" class="form-select form-select-sm"><option value="">all layers</option>
                            @foreach (var l in Model.Layers) { <option value="@l.LayerId">@l.Name</option> }</select>
                    </div>
                    <div class="input-group input-group-sm">
                        <input name="text" class="form-control" maxlength="2000" required placeholder="A lesson for every pass" />
                        <button class="btn btn-outline-primary">Teach</button>
                    </div>
                </form>
            }
        </details>

        <details class="mb-3">
            <summary class="h6">What they looked at (@Model.Queries.Count)</summary>
            @foreach (var q in Model.Queries)
            {
                <div class="mb-1 @(q.Accepted ? "" : "text-warning-emphasis")">
                    <span class="text-muted">@q.CalledAtUtc.ToLocalTime().ToString("ddd HH:mm")</span> @q.Agent · @q.Tool · @q.RowCount rows, @q.DurationMs ms
                    @if (!q.Accepted) { <span>refused: @q.Error</span> }
                    <div><code class="text-break">@(q.Request.Length > 220 ? q.Request[..220] + "…" : q.Request)</code></div>
                </div>
            }
        </details>
    </aside>
</div>

<script>
    (function () {
        var thread = document.getElementById('thread');
        var toggle = document.getElementById('show-activity');
        function apply() {
            document.querySelectorAll('#thread .activity').forEach(function (e) { e.style.display = toggle.checked ? '' : 'none'; });
            thread.scrollTop = thread.scrollHeight;
        }
        try { toggle.checked = localStorage.getItem('chat-show-activity') !== '0'; } catch (e) { }
        toggle.addEventListener('change', function () { try { localStorage.setItem('chat-show-activity', toggle.checked ? '1' : '0'); } catch (e) { } apply(); });
        apply();
    })();
</script>
@if (Model.TurnRunning || Model.ProblemsRunning)
{
    <script>setTimeout(function () { location.reload(); }, 4000);</script>
}
