@model PricingTool.Agent.Backtest.BacktestSnapshotData?
@using PricingTool.Agent.Backtest
@{
    ViewData["Title"] = "Backtest";
    var record = ViewData["Record"] as PricingTool.Agent.Storage.BacktestSnapshotRecord;
    string[] names = { "", "Loss-sale block", "Per-category floors", "Cost reaction", "Coverage MK/AL", "Cadence", "Learning", "Campaign planning", "Raises reach the shelf" };
    // Every lever on the calculator's era (framing A's baseline is today's process); the stored run goes back to Oct 2025 for
    // context, and lever 3's low case in numbers.json leaves out August's one cost event.
    var testMonths = new[] { "2026-08", "2026-09" };
    string[] MonthsFor(int lever) => testMonths;
    decimal MonthlyAverage(LeverBacktestResult r, int lever, decimal e) =>
        r.Gains.Where(g => g.Lever == lever && g.Elasticity == e && MonthsFor(lever).Contains(g.Month)).Sum(g => g.Gain) / MonthsFor(lever).Length;
    decimal MonthlyTeamDeal(LeverBacktestResult r, int lever) =>
        r.Gains.Where(g => g.Lever == lever && g.Elasticity == -1.0m && MonthsFor(lever).Contains(g.Month)).Sum(g => g.TeamDealGain) / MonthsFor(lever).Length;
}

<h1 class="h3">Backtest</h1>
<p class="page-sub">What v2 would have added, lever by lever, on past sales. Every figure is <strong>estimated</strong> unless marked measured; the low case (e −2.0) is the number for Finance.</p>
<details class="how"><summary>How this works</summary>
    Booked sales lines (booked COGS, EUR VAT excluded), walk-forward, each line counted by one lever only. Elasticity cases −0.5 / −1.0 / −2.0.
    The method and what each lever rests on: <code>docs/hackathon-2026/backtest-results.md</code>.
</details>
@if (Model is null || record is null)
{
    <div class="alert alert-warning">No backtest stored yet. Run <code>PricingTool.AgentTools backtest-snapshot</code> (about a minute).</div>
    return;
}
<p class="small">Backtest run #@record.Id, @record.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") (@record.Seconds s); data window
    @Model.From.ToString("dd MMM yyyy") – @Model.To.AddDays(-1).ToString("dd MMM yyyy"). <a class="btn btn-sm btn-outline-primary ms-2" asp-action="Csv">Download CSV</a></p>

<h2 class="h5 mt-3">Levers 1–3, 5, 6, 8: monthly average over Aug–Sep 2026, the calculator's era (EUR)</h2>
<table class="table table-sm align-middle">
    <thead><tr><th>Layer</th><th>Lever</th><th class="text-end">e −0.5</th><th class="text-end">e −1.0</th><th class="text-end">e −2.0 (low)</th><th class="text-end">of e −1.0 under a team deal</th><th>Oct 1–15 (e −1.0)</th></tr></thead>
    <tbody>
    @foreach (var r in Model.Levers)
    {
        foreach (var lever in new[] { 1, 2, 3, 5, 6, 8 })                                  // a lever at zero is shown as zero
        {
            <tr>
                <td>@(r.LayerId == 1 ? "GjirafaMall KS" : r.LayerId == 4 ? "Gjirafa50 KS" : $"Layer {r.LayerId}")</td>
                <td>@lever @names[lever]</td>
                @foreach (var e in new[] { -0.5m, -1.0m, -2.0m })
                {
                    <td class="text-end">@MonthlyAverage(r, lever, e).ToString("N0")</td>
                }
                <td class="text-end">@MonthlyTeamDeal(r, lever).ToString("N0")</td>
                <td>@(r.Gains.Where(g => g.Lever == lever && g.Elasticity == -1.0m && g.Month == "2026-10").Sum(g => g.Gain).ToString("N0"))</td>
            </tr>
        }
    }
    </tbody>
</table>
<p class="small text-muted">Lever 8, raises reach the shelf: in today's process 17–20 % of the units on SKUs an approval raised still sold at the
    old price (Aug–Sep), 70–84 % in late October (E23, <code>evidence/raises-not-on-shelf.sql</code>). Lever 8 prices the part v2's publisher
    removes (the calculator's earlier push still live, or a regular price never raised) at the new price, on lines no other lever scored;
    a team deal holding the old price is left to a person. "Under a team deal": the part of a lever's gain on lines sold under a
    product discount at a price no approval gave the SKU; v2 doesn't raise a price a team deal holds, so numbers.json moves it from
    the central case to the high one.</p>
<p class="small text-muted">Measured beside them: cross-dock lines sold under booked cost on normal days, per month:
    @foreach (var r in Model.Levers)
    {
        <span>layer @r.LayerId: @string.Join(", ", r.Context.Select(c => $"{c.Month} {c.CrossDockLoss:N0} ({c.CaughtLoss:N0} caught)"));</span>
    }
</p>

<h2 class="h5 mt-3">Lever 7: the planner's depth per SKU vs each campaign's, as deep on average (EUR)</h2>
<table class="table table-sm align-middle small">
    <thead><tr><th>Layer</th><th>Campaign</th><th>Days</th><th class="text-end">Actual GP</th><th class="text-end">Reallocated</th><th class="text-end">Gain</th><th class="text-end">Per day (curve ×0.5 / ×2)</th><th>Depth</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Campaigns)
    {
        foreach (var g in c.DepthGains.Where(g => g.BScale == 1m && g.Strategy == "reallocate" && g.SkusScored > 0))
        {
            var half = c.DepthGains.FirstOrDefault(x => x.CampaignId == g.CampaignId && x.Strategy == g.Strategy && x.BScale == 0.5m);
            var dbl = c.DepthGains.FirstOrDefault(x => x.CampaignId == g.CampaignId && x.Strategy == g.Strategy && x.BScale == 2m);
            <tr>
                <td>@c.LayerId</td><td>@g.Name</td><td>@g.Days</td><td class="text-end">@g.ActualGp.ToString("N0")</td><td class="text-end">@g.PlannedGp.ToString("N0")</td>
                <td class="text-end">@g.Gain.ToString("N0")</td><td class="text-end">@g.GainPerDay.ToString("N0") (@half?.GainPerDay.ToString("N0") / @dbl?.GainPerDay.ToString("N0"))</td>
                <td>@g.ActualDepthPct.ToString("0.0")% → @g.PlannedDepthPct.ToString("0.0")%</td>
                <td>@(g.Provisional ? "provisional " : "")@(g.Representative ? "" : "not representative")</td>
            </tr>
        }
    }
    </tbody>
</table>

<h2 class="h5 mt-3">The planner's estimates against what campaigns made (leave-one-out)</h2>
<table class="table table-sm align-middle small">
    <thead><tr><th>Layer</th><th>Campaign</th><th class="text-end">Actual GP</th><th class="text-end">Planned</th><th class="text-end">Actual / planned</th><th>Event lift</th><th class="text-end">GP from SKUs unseen before</th></tr></thead>
    <tbody>
    @foreach (var c in Model.Campaigns)
    {
        foreach (var r in c.Replays)
        {
            <tr class="@(r.Usable ? "" : "text-muted")">
                <td>@c.LayerId</td><td>@r.Name</td><td class="text-end">@r.ActualGp.ToString("N0")</td><td class="text-end">@r.PredictedSeenGp.ToString("N0")</td>
                <td class="text-end">@(r.TotalRatio is { } t ? $"×{t:0.00}" : "")</td><td>@(r.SeenType ? $"×{r.EventLift:0.00}" : "none (×1)")</td>
                <td class="text-end">@r.TailSharePct.ToString("0")%</td>
            </tr>
        }
        <tr><td colspan="7" class="small">Layer @c.LayerId: @(c.SeenType?.Basis ?? "no factor for types with an event lift (too few replays)")@(c.InSample is { } i ? $"; in-sample, for comparison only: ×{i.Factor:0.00}" : "").</td></tr>
    }
    </tbody>
</table>

<h2 class="h5 mt-3">Lever 4: the Kosovo effect on MK/AL months without a push (EUR)</h2>
<table class="table table-sm align-middle small">
    <thead><tr><th>Case</th><th>Kosovo effect</th>@foreach (var m in Model.Coverage.Select(g => g.Month).Distinct().OrderBy(m => m)) { <th class="text-end">@m</th> }</tr></thead>
    <tbody>
    @foreach (var e in Model.CoverageEffects)
    {
        <tr>
            <td>@e.Case</td><td>€@e.GainPerMonth.ToString("N0") = @((100m * e.Ratio).ToString("0.0"))% of KS GP (@e.Source)</td>
            @foreach (var m in Model.Coverage.Select(g => g.Month).Distinct().OrderBy(m => m))
            {
                <td class="text-end">@(Model.Coverage.FirstOrDefault(g => g.Case == e.Case && g.Month == m)?.Gain.ToString("N0"))</td>
            }
        </tr>
    }
    </tbody>
</table>
<p class="small text-muted">MK/AL tool-scope GP per month in EUR at the load day's shop rate (MKD is pegged; ALL at today's rate); months with a regular-price push of
    their own are left out.</p>
