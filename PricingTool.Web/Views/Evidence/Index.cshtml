@model PricingTool.Web.Services.EvidencePage
@using PricingTool.Web.Services
@{
    ViewData["Title"] = "Evidence";
    var byId = Model.Figures.ToDictionary(f => f.Id);
    string ValueOf(string id) => byId.TryGetValue(id, out var f) ? EvidenceService.Show(f.Value) : "not in numbers.json";
    // The plan's list (section 5, "Evidence page"): what each item is, as references to numbers.json; no figure is typed here.
    var planList = new (string Item, string[] Ids)[]
    {
        ("The calculator's Aug–Sep lift: mid, before/after (framing B's claim); low, the controlled measurement, shown under it; high, season-adjusted, quoted, not part of the claim", new[] { "E20" }),
        ("The same-weeks control (changed vs unchanged products in the same weeks): E20 low", new[] { "E20" }),
        ("The year-over-year margin fingerprint", new[] { "E25" }),
        ("Për ty Oct 2026: the agents' plan vs the hand plan's forecast vs what it made", new[] { "E11", "E12" }),
        ("Cross-dock lines sold under booked cost, last 12 months", new[] { "E14" }),
        ("Below-floor gross profit forgone, by cause", new[] { "E21" }),
        ("The Kosovo gross-profit base", new[] { "E13" }),
        ("The backtest result (framing A and its levers)", new[] { "E8", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E24" }),
        ("The Sales Report tie-out (each approval's 30 days before: the tool vs the exported lines)", new[] { "E26" }),
    };
}

<h1 class="h3">Evidence</h1>
<p class="text-muted">
    Every figure of <code>docs/hackathon-2026/evidence/numbers.json</code> (built @Model.Generated by <code>build-numbers.ps1</code>), with its
    label, method, sources and where it is used. Figures whose script is a SQL file can be <strong>recomputed live</strong> here: the page runs
    that exact file against the hackathon database as <code>evidence_reader</code> (read-only), within 60 s, and compares each cell with the stored
    value. The backtest figures come from the stored backtest run; the command that recomputes them is shown, it isn't run from the page.
    <span class="small">@Model.Note</span>
</p>

<h2 class="h5 mt-3">The plan's list</h2>
<table class="table table-sm align-middle">
    <thead><tr><th>Item</th><th>Figure</th><th>Value (central, low / high)</th></tr></thead>
    <tbody>
    @foreach (var (item, ids) in planList)
    {
        <tr>
            <td>@item</td>
            <td>@foreach (var id in ids) { <a href="#@id" class="me-1">@id</a> }</td>
            <td class="small">@ValueOf(ids[0])@if (ids[0] == "E20" && byId.TryGetValue("E20", out var e20) && e20.SinceRegistration is { } why && item.StartsWith("The calculator", StringComparison.Ordinal))
                { <div class="text-muted mt-1">Since the registration: @why</div> }</td>
        </tr>
    }
    </tbody>
</table>

<h2 class="h5 mt-4">Every figure (@Model.Figures.Count)</h2>
@if (Model.LoadsError is { } err)
{
    <div class="alert alert-warning small">hk.DataSources couldn't be read: @err</div>
}
@Html.AntiForgeryToken()
<table class="table table-sm align-top" id="figures">
    <thead><tr><th>ID</th><th>Figure</th><th>Value</th><th>Label</th><th>Method and sources</th><th>Used in</th><th>Recompute</th></tr></thead>
    <tbody>
    @foreach (var f in Model.Figures)
    {
        var sources = EvidenceService.SourcesOf(f, Model.Loads);
        var uses = Model.Uses.TryGetValue(f.Id, out var u) ? u : Array.Empty<string>();
        <tr id="@f.Id">
            <td class="fw-bold">@f.Id</td>
            <td>@f.Name <div class="small text-muted">@f.Unit</div></td>
            <td class="small" style="max-width: 22rem">@EvidenceService.Show(f.Value)</td>
            <td class="small">@EvidenceService.ShowLabel(f.Label)</td>
            <td class="small" style="max-width: 30rem">
                <details><summary>method</summary>@f.Method</details>
                <div>Source: @f.Source</div>
                @foreach (var (table, loaded) in sources)
                {
                    <div class="text-muted">@table loaded @loaded!.Value.ToString("yyyy-MM-dd HH:mm") UTC (hk.DataSources)</div>
                }
                <div>Script: <code>@f.Script</code></div>
            </td>
            <td class="small">
                @if (uses.Count == 0) { <span>—</span> }
                @foreach (var g in uses.GroupBy(x => x.StartsWith("sheet ", StringComparison.Ordinal) ? "sheet" : x[..x.IndexOf(" line ", StringComparison.Ordinal)]))
                {
                    <div><strong>@g.Key</strong>: @string.Join(", ", g.Select(x => g.Key == "sheet" ? x["sheet ".Length..] : x[(x.IndexOf(" line ", StringComparison.Ordinal) + 6)..]))</div>
                }
            </td>
            <td class="small" style="min-width: 14rem">
                @if (f.Recompute is { } r)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary recompute" data-file="@r.File">Recompute live</button>
                    <div class="text-muted"><code>@r.File</code></div>
                    <table class="table table-sm mt-1 mb-0 checks" data-file="@r.File">
                        @foreach (var c in r.Checks)
                        {
                            <tr data-label="@c.Label" data-figure="@f.Id"><td>@c.Label</td><td class="text-end">@(c.Value?.ToString("0.##") ?? "n/a")</td><td class="live text-end"></td></tr>
                        }
                    </table>
                    <div class="result"></div>
                }
                else if (f.Source.StartsWith("ai.BacktestSnapshot", StringComparison.Ordinal))
                {
                    <div>Stored run: @f.Source</div>
                    <div class="text-muted">Recompute: <code>@f.Script</code> (about 90 s; not run from the page)</div>
                }
                else
                {
                    <div class="text-muted">Not a SQL file: <code>@f.Script</code></div>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@section Scripts {
<script>
    document.querySelectorAll('button.recompute').forEach(btn => btn.addEventListener('click', async () => {
        const file = btn.dataset.file;
        const cell = btn.parentElement.querySelector('.result');
        btn.disabled = true;
        cell.textContent = 'running ' + file + ' …';
        const body = new URLSearchParams({ file, __RequestVerificationToken: document.querySelector('input[name="__RequestVerificationToken"]').value });
        const res = await fetch('@Url.Action("Recompute", "Evidence")', { method: 'POST', body });
        btn.disabled = false;
        if (!res.ok) { cell.textContent = 'refused: ' + await res.text(); return; }
        const r = await res.json();
        let same = 0;
        for (const line of r.lines) {
            document.querySelectorAll(`table.checks[data-file="${file}"] tr`).forEach(tr => {
                if (tr.dataset.label !== line.label || tr.dataset.figure !== line.figureId) return;
                const live = tr.querySelector('.live');
                const diff = line.live === null || line.stored === null ? null : line.live - line.stored;
                live.textContent = line.live === null ? 'n/a' : line.live + (line.matches ? ' ✓' : ` (${diff > 0 ? '+' : ''}${diff.toFixed(2)})`);
                live.className = 'live text-end ' + (line.matches ? 'text-success' : 'text-danger');
                if (line.matches) same++;
            });
        }
        cell.textContent = `${same} of ${r.lines.length} match, ${(r.ms / 1000).toFixed(1)} s, run as evidence_reader`;
    }));
</script>
}
