{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PricingToolDb": "Server=(localdb)\\mssqllocaldb;Database=PricingTool;Trusted_Connection=True;MultipleActiveResultSets=true",
    "SourceReadOnly": "Server=(localdb)\\mssqllocaldb;Database=GjirafaMall;Trusted_Connection=True;ApplicationIntent=ReadOnly"
  },
  "SourceDataset": {
    "Mode": "StoredProcedure"
  },
  "Porta": {
    "_comment": "Gjirafa Porta SSO (OpenID Connect). Leave Authority/ClientId blank locally to run with the dev no-auth shim. In prod these are set inline on the k8s web deployment as Porta__* env vars.",
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "Scope": "openid profile email",
    "InitialAdminEmail": ""
  },
  "PricingEngine": {
    "VatRatePct": 18.0,
    "StockoutRiskDays": 14,
    "NewProductProtectionDays": 90,
    "ChangeConfirmationThresholdPct": 20.0,
    "OutcomeMaturityGraceDays": 28,
    "RetentionEnabled": true,
    "SnapshotRetentionDays": 14,
    "RetentionIncludesProposals": true,
    "RunRetentionDays": 3,
    "UseDemoData": true,
    "DefaultRunTimeUtc": "03:00",
    "DefaultCadenceHours": 24,
    "SlowLaneCadenceDays": 15,
    "ElasticityFitCadenceDays": 15,
    "PushExportDirectory": "exports"
  }
}
